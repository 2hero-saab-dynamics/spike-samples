        <SPECIFICATION IDENTIFIER="SPEC-GSR" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="Ground-station telemetry relay">
          <TYPE><SPECIFICATION-TYPE-REF>ST-SPECIFICATION</SPECIFICATION-TYPE-REF></TYPE>
