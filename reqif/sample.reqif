  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-GSR-SAMPLE">
      <COMMENT>Invented sample for the Spiking Lab. Ground-station telemetry relay. Not a real system.</COMMENT>
      <CREATION-TIME>2026-10-06T09:00:00Z</CREATION-TIME>
      <REQ-IF-TOOL-ID>spike-samples</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>hand-written</SOURCE-TOOL-ID>
      <TITLE>Ground-station telemetry relay requirements</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STRING" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="String" MAX-LENGTH="2000"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT-REQUIREMENT" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-FOREIGN-ID" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="ReqIF.ForeignID">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-TEXT" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="ReqIF.Text">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>DT-STRING</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="ST-SPECIFICATION" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="Specification"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-001" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-001">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-001">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall reject any telemetry frame whose CRC-16 trailer does not match the frame payload, and shall not forward a rejected frame.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-002" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-002">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-002">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall stamp each received frame with the UTC time of reception, to millisecond resolution, before any other processing.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-003" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-003">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-003">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="While the downstream link is unavailable, the relay shall buffer up to 10 000 frames and, when the link returns, forward them in order of reception.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-004" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-004">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-004">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall drop from the buffer any frame older than 300 seconds, and shall log each dropped frame with its sequence number.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-005" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-005">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-005">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall load its configuration only if the configuration file carries a valid signature from the operator's key; otherwise it shall refuse to start.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-006" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-006">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-006">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall provide a health endpoint that reports buffer occupancy, downstream link state and seconds since the last received frame.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-007" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-007">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-007">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall write every operator command, with its outcome, to the audit log before the command's effect is applied.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO-GSR-REQ-008" LAST-CHANGE="2026-10-06T09:00:00Z" LONG-NAME="GSR-REQ-008">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="GSR-REQ-008">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The relay shall forward at most 500 frames per second to the downstream link and shall queue, not drop, any excess.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
